# ===========================================
# Halo Environment Configuration
# ===========================================

# Anthropic Claude API
ANTHROPIC_API_KEY=your-anthropic-api-key-here
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# Embeddings (sentence-transformers - local, free)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# RAG (ChromaDB - local)
CHROMA_PERSIST_DIR=./knowledge/chroma_db
RAG_TOP_K=5

# Stellar (Testnet only)
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HOT_WALLET_SECRET=

# Database
DATABASE_URL=postgresql://halo:halo@localhost:5432/halo

# Docker (Stellar contract compilation can take several minutes)
DOCKER_TIMEOUT_SECONDS=300

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Vercel OAuth (for users to publish to their own Vercel accounts)
# Create a Vercel App and set its callback URL to: http://localhost:3000/api/vercel/callback
VERCEL_OAUTH_CLIENT_ID=cl_RWEDBjivgdXBdmB0JOkUdFTA0RJbORnP
VERCEL_OAUTH_CLIENT_SECRET=d70a2f5986818ef3cdb4087e4c325aa9c3d84ce0e65820b892d7470527396165
VERCEL_OAUTH_REDIRECT_URI=http://localhost:3000/api/vercel/callback

# (Optional) Platform token fallback (if you still want it)
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=
